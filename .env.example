IMAGE_UPLOAD_HOST=127.0.0.1
IMAGE_UPLOAD_PORT=8080
IMAGE_STORAGE_ROOT=/Volumes/gorani-images/image-store
IMAGE_REQUIRE_STORAGE_MOUNT=1
IMAGE_PUBLIC_PREFIX=/i
IMAGE_MAX_UPLOAD_BYTES=20971520
IMAGE_MAX_IMAGE_PIXELS=40000000
IMAGE_MAX_WORKERS=8
IMAGE_HTTP_TIMEOUT_SECONDS=30
IMAGE_CLEANUP_BATCH_SIZE=10
IMAGE_COMMAND_TIMEOUT_SECONDS=30
IMAGE_DB_TIMEOUT_SECONDS=10
IMAGE_ENABLE_THUMBNAILS=1
IMAGE_THUMBNAIL_WIDTHS=160,320,640
IMAGE_THUMBNAIL_FORMAT=webp
IMAGE_API_KEYS=
PGDATABASE=postgres
